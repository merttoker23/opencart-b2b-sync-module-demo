{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <h1>{{ heading_title }}</h1>
    </div>
  </div>
  <div class="container-fluid">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" class="form-horizontal">
      <div class="form-group">
        <label class="col-sm-2 control-label" for="input-status">Status</label>
        <div class="col-sm-10">
          <select name="module_b2b_sync_status" id="input-status" class="form-control">
            <option value="1" {% if module_b2b_sync_status %}selected{% endif %}>Enabled</option>
            <option value="0" {% if not module_b2b_sync_status %}selected{% endif %}>Disabled</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label class="col-sm-2 control-label" for="input-feed-url">Supplier Feed URL</label>
        <div class="col-sm-10">
          <input type="text" name="module_b2b_sync_feed_url" value="{{ module_b2b_sync_feed_url }}" id="input-feed-url" class="form-control" />
        </div>
      </div>
      <div class="form-group">
        <label class="col-sm-2 control-label" for="input-margin">Price Margin %</label>
        <div class="col-sm-10">
          <input type="number" step="0.01" name="module_b2b_sync_margin" value="{{ module_b2b_sync_margin }}" id="input-margin" class="form-control" />
        </div>
      </div>
      <button type="submit" class="btn btn-primary">Save</button>
      <a href="{{ cancel }}" class="btn btn-default">Cancel</a>
    </form>
  </div>
</div>
{{ footer }}
